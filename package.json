{
  "name": "resume-site",
  "version": "0.0.0-semantically-released",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/nest-export.mts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && npm run api:types && tsc --noEmit -p api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "serve dist -l 4173",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:e2e",
    "resume:pdf": "npm run build && node scripts/generate-resume-pdf.mts",
    "resume:check": "npm run build && node scripts/check-resume-pdf.mts",
    "hub:build": "node scripts/build-hub.mts",
    "hub:preview": "npm run hub:build && serve hub/dist -l 4175",
    "api:types": "wrangler types api/worker-configuration.d.ts --config api/wrangler.jsonc",
    "api:dev": "wrangler dev --config api/wrangler.jsonc",
    "api:migrate": "wrangler d1 migrations apply patrickkearney-api --local --config api/wrangler.jsonc",
    "api:build": "wrangler deploy --dry-run --config api/wrangler.jsonc",
    "commitlint": "commitlint --from origin/develop --to HEAD --verbose",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "geist": "^1.9.2",
    "hono": "^4.13.18",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=22"
  }
}
