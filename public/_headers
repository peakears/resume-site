# Cloudflare response headers. https://developers.cloudflare.com/workers/static-assets/headers/
# Write paths as if the site were at the root: `npm run build` moves this file
# to dist/ and adds the base path (/resume) to each pattern.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The static export writes the link-preview image without a file extension.
/opengraph-image
  Content-Type: image/png
