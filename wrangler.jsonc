// Cloudflare Workers config: serve the static export as plain files.
// Without this file, `wrangler deploy` guesses that a Next.js app needs a
// server and tries to convert it with OpenNext, which fails for a static
// export. https://developers.cloudflare.com/workers/static-assets/
{
  "name": "resume-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    // `npm run build` writes the export to dist/resume/, so files sit at the
    // paths they're requested at (patrickkearney.dev/resume/...).
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // The resume owns /resume on the apex domain; the hub Worker
  // (hub/wrangler.jsonc) takes everything else. The more specific route wins.
  // Two patterns so /resume matches but /resumes or /resume-old don't.
  "routes": [
    {
      "pattern": "patrickkearney.dev/resume",
      "zone_name": "patrickkearney.dev",
    },
    {
      "pattern": "patrickkearney.dev/resume/*",
      "zone_name": "patrickkearney.dev",
    },
  ],
  // Matches the dashboard setting. Workers Logs isn't needed for a site
  // that serves only static files; traffic stats come from Web Analytics.
  "observability": {
    "enabled": false,
  },
}
